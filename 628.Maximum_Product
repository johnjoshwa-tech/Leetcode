class Solution {
    public int maximumProduct(int[] nums) {
        if(nums.length<3) return -1;
       Arrays.sort(nums);
       int prod1=1;
       int prod2=1;
       for(int i=0;i<2;i++){
        prod1*=nums[i];
       }
       prod1*=nums[nums.length-1];
       for(int i=nums.length-1;i>nums.length-4;i--){
        prod2*=nums[i];
       }
       if(prod1>prod2) return prod1;
       return prod2;
       
    }
}
