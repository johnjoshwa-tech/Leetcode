class Solution {
    public int[][] flipAndInvertImage(int[][] image) {
        int res[][]=new int[image.length][image[0].length];
        for(int i=0;i<image.length;i++){
            for(int j=0;j<image[0].length;j++){
                if(image[i][j]==0){
                    res[i][image[0].length-j-1]=1;
                }
            }
        }
        return res;
    }
}
