class Solution {
    boolean flag=false;
    int max=0,temp=0;
    public int maximumGap(int[] nums) {
        if(nums.length<2) return 0;

        Arrays.sort(nums);

        for(int i=1;i<nums.length;i++){
            temp = nums[i] - nums[i-1];
            if(temp > max)
                max = temp;
}
      return max;         
    }
}
