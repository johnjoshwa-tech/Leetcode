class Solution {
    public int maxProfit(int[] prices) {
       int maxProfit=0;
       int minCost=prices[0];
       for(int i=0;i<prices.length-1;i++){
          if(prices[i]<minCost) minCost=prices[i];
          if(prices[i+1]-minCost>maxProfit) maxProfit=prices[i+1]-minCost;
       }
return maxProfit;
    }
}
